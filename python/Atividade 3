#Resposta do chat
try:
    NotaDeRisco = int(input("Escreva uma nota de risco de 0 a 10? "))

    if NotaDeRisco < 0 or NotaDeRisco > 10:
        print("Valor inválido! Digite uma nota entre 0 e 10.")
    elif NotaDeRisco <= 3:
        print("Risco Baixo")
    elif NotaDeRisco <= 7:
        print("Risco Médio")
    else:
        print("Risco Alto")

except ValueError:
    print("Valor inválido! Digite apenas números.")

